# 网关配置库（必填，启动时连接）
FEDERAL_DB_URL=jdbc:mysql://127.0.0.1:3306/federal?sslMode=DISABLED&allowPublicKeyRetrieval=true&characterEncoding=utf8
FEDERAL_DB_USER=federation
FEDERAL_DB_PASSWORD=federation

# Trino
TRINO_JDBC_URL=jdbc:trino://localhost:8081
TRINO_USER=federation
TRINO_PASSWORD=

# 鉴权始终开启；请求需带 Authorization: Bearer <token>（或先走控制台登录）
# FEDERATION_SECURITY_ENABLED 已废弃（false 也不会关闭鉴权）
# 首次启动可在控制台配置管理员，或用下面两项自动创建：
# FEDERATION_ADMIN_USER=admin
# FEDERATION_ADMIN_PASSWORD=change-me-now
# demo=QUERY+ADMIN；reader=仅 QUERY（不可改数据源/本体/模型）
FEDERATION_DEMO_TOKEN=demo-token
FEDERATION_READER_TOKEN=reader-token
FEDERATION_QUOTA_PER_MINUTE=120
# 可选：按用户限制 catalog（YAML federation.security.catalogs，如 reader: mysql_shop）

# 可选：OTLP tracing（空则不上报）
OTEL_EXPORTER_OTLP_ENDPOINT=
TRACING_SAMPLE_PROBABILITY=1.0

# 可选：外部 IdP JWT（issuer-uri 非空时，Bearer 可为 JWT）
FEDERATION_JWT_ISSUER_URI=
FEDERATION_JWT_ROLES_CLAIM=roles

# 控制台 OIDC PKCE（写入 web/.env.local，构建时注入）
# VITE_OIDC_AUTHORITY=https://idp.example/realms/federation
# VITE_OIDC_CLIENT_ID=federation-console
# VITE_OIDC_REDIRECT_URI=http://localhost:5173/
# VITE_OIDC_SCOPE=openid profile roles

# 大模型（也可在控制台「模型」里配置，写入 fed_llm）
LLM_PROTOCOL=openai
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# CORS（逗号分隔）
FEDERATION_CORS_ORIGINS=http://localhost:5173,http://localhost:18080

# 知识库向量（默认本机 Milvus；留空 MILVUS_URI= 才退回进程内索引，仅单测）
MILVUS_URI=http://127.0.0.1:19530
# 云端嵌入初值（也可在控制台左侧「模型 → 嵌入模型」配置，写入 fed_ask_embed）
# 须写到 …/embeddings；智谱需有嵌入资源包
FEDERATION_ASK_EMBED_ENDPOINT=https://open.bigmodel.cn/api/paas/v4/embeddings
FEDERATION_ASK_EMBED_API_KEY=
FEDERATION_ASK_EMBED_MODEL=embedding-3
ONTOLOGY_STORE=data/tdb2
