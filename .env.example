# 网关配置库（必填，启动时连接）
FEDERAL_DB_URL=jdbc:mysql://127.0.0.1:3306/federal?sslMode=DISABLED&allowPublicKeyRetrieval=true&characterEncoding=utf8
FEDERAL_DB_USER=federation
FEDERAL_DB_PASSWORD=federation

# Trino
TRINO_JDBC_URL=jdbc:trino://localhost:8081
TRINO_USER=federation
TRINO_PASSWORD=

# 可选：开启 API 鉴权后，请求需带 Authorization: Bearer <token>
FEDERATION_SECURITY_ENABLED=false
FEDERATION_DEMO_TOKEN=demo-token
FEDERATION_QUOTA_PER_MINUTE=120

# 大模型（也可在控制台「模型」里配置，写入 fed_llm）
LLM_PROTOCOL=openai
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# 可选
MILVUS_URI=
ONTOLOGY_STORE=data/tdb2
