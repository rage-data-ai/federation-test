# 复制为 application-dev.yml 后按环境修改（该文件已 gitignore）。
# 启动：SPRING_PROFILES_ACTIVE=dev mvn spring-boot:run

federation:
  repository:
    url: jdbc:mysql://127.0.0.1:3306/federal?sslMode=DISABLED&allowPublicKeyRetrieval=true&characterEncoding=utf8
    username: federation
    password: federation
  security:
    enabled: false
  trino:
    url: jdbc:trino://localhost:8081
    user: federation
